# Model to use for extraction + scoring. Leave unset to auto-pick Gemma 4
# (gemma4:31b-mlx when it is pulled in Ollama).
#DEFAULT_MODEL=gemma4:31b-mlx

# Local Ollama host (used for auto-detection and as the base URL for local models)
OLLAMA_HOST=http://localhost:11434

# Development mode: 1 enables response caching + CSV export in the vendored core.
# 0 (default) keeps the app stateless and fast.
#CV_EVAL_DEVELOPMENT_MODE=0

# ---- Provider overrides (optional). The app auto-detects local models, so these
# are only needed for remote/cloud providers. ----
# GitHub enrichment uses the unauthenticated API (60 req/hr) unless set.
# A classic PAT raises the cap to 5,000 req/hr. Leave unset if you score
# without GitHub signals (the UI default).
#GITHUB_TOKEN=

#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=

# Machine-sticky CLI/env keys. The web UI does not read or write these —
# paste a key on wizard step 03 for a single run instead.
#GEMINI_API_KEY=
#OLLAMA_API_KEY=
